# Postgres (Neon). Em produção, criar a integração Neon<->Vercel deixa isso automático.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"

# LiveKit Cloud (livekit.io) — Settings -> Keys do seu projeto.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://seu-projeto.livekit.cloud"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório longo.
AUTH_SECRET="troque-este-valor-por-algo-aleatorio-e-longo"

# Vercel Blob (fotos, logo, sons, fundos). Em produção é injetado automaticamente pela
# integração; localmente, rode `vercel env pull` depois de `vercel link` pra puxar o valor.
BLOB_READ_WRITE_TOKEN=""
