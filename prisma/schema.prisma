// Reunião — ferramenta interna de videoconferência (câmeras, áudio, tela compartilhada).
// Produção: Postgres (Neon). Motor de mídia: LiveKit Cloud (fora do schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Configurações padrão aplicadas a toda sala nova. Singleton (uma linha só),
// mesma convenção de AppSettings do Elementa.
model AppSettings {
  id                      String   @id @default(cuid())
  brandName               String   @default("Reunião")
  logoUrl                 String?
  faviconUrl              String?
  primaryColor            String   @default("#8b5cf6")
  salasColor              String   @default("#a78bfa")
  usuariosColor           String   @default("#fb923c")
  configuracoesColor      String   @default("#22d3ee")
  defaultMaxParticipants  Int      @default(12)
  defaultMuteOnEntry      Boolean  @default(false)
  defaultCameraOnEntry    Boolean  @default(true)
  defaultAllowScreenShare Boolean  @default(true)
  defaultWaitingRoom      Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

// Conta de acesso. ADMIN gerencia usuários/salas/configurações; USER só entra e cria
// salas instantâneas. activeSeconds/screenShareCount são estatísticas de uso reportadas
// pelo próprio cliente durante a chamada (não há infra de webhook do LiveKit).
model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             String   @default("USER") // "ADMIN" | "USER"
  jobTitle         String?
  photoUrl         String?
  photoPositionX   Float    @default(50)
  photoPositionY   Float    @default(50)
  photoZoom        Float    @default(1)
  activeSeconds    Int      @default(0)
  screenShareCount Int      @default(0)
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms Room[]
}

model Room {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  hostName         String
  password         String?
  maxParticipants  Int      @default(12)
  muteOnEntry      Boolean  @default(false)
  cameraOnEntry    Boolean  @default(true)
  allowScreenShare Boolean  @default(true)
  waitingRoom      Boolean  @default(false)
  isActive         Boolean  @default(true)
  isInstant        Boolean  @default(false)
  createdByUserId  String?
  createdBy        User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recordings Recording[]
}

// Gravação de uma sala via Egress do LiveKit. O arquivo em si fica num bucket S3
// privado (fileKey); o download é sempre por URL assinada e temporária, nunca pública.
model Recording {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  egressId    String    @unique
  status      String    @default("STARTING") // STARTING | ACTIVE | ENDING | COMPLETE | FAILED
  fileKey     String?
  durationSec Int?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
}

// Biblioteca de sons compartilhada entre todas as salas (estilo soundboard do Discord).
// Arquivos ficam no Vercel Blob; aqui só o metadado + a URL.
model SoundboardSound {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  audioUrl  String
  createdAt DateTime @default(now())
}

// Biblioteca de imagens de fundo virtual, compartilhada entre todas as salas.
model BackgroundImage {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
}
